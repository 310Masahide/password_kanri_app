{
  "manifest_version": 3,
  "name": "パスワード管理アプリ 連携",
  "version": "0.2.0",
  "description": "パスワード管理アプリに登録したIDとパスワードを、ログイン画面に入力します。",
  "action": {
    "default_title": "パスワード管理アプリ",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "このサイトのアカウントを入力する"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://password-kanri-app.onrender.com/*"
  ]
}

