<%= form_with(model: account) do |form| %>
  <% if current_user.guest? %>
    <div class="alert alert-warning">ゲストは全員で共有するアカウントです。本物のパスワードは登録しないでください。</div>
  <% end %>

  <% if account.errors.any? %>
    <div class="alert alert-danger">
      <p class="fw-bold mb-1"><%= account.errors.count %>件のエラーがあります</p>
      <ul class="mb-0">
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :service_name, class: "form-label" %>
    <%= form.text_field :service_name, class: "form-control", placeholder: "例：Amazon" %>
  </div>

  <div class="mb-3">
    <%= form.label :login_id, class: "form-label" %>
    <%= form.text_field :login_id, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :password, class: "form-label" %>
    <div class="input-group" data-controller="password">
      <%= form.password_field :password, value: account.password, autocomplete: "new-password", class: "form-control", data: { password_target: "field" } %>
      <button type="button" class="btn btn-outline-secondary" data-password-target="button" data-action="password#toggle">表示</button>
      <button type="button" class="btn btn-outline-primary" data-action="password#generate">自動作成</button>
    </div>
    <div class="form-text">「自動作成」を押すと、ランダムな16文字のパスワードが入ります。</div>
  </div>

  <div class="mb-3">
    <%= form.label :url, class: "form-label" %>
    <%= form.url_field :url, class: "form-control", placeholder: "https://" %>
  </div>

  <div class="mb-4">
    <%= form.label :memo, class: "form-label" %>
    <%= form.text_area :memo, class: "form-control", rows: 3 %>
  </div>

  <%= form.submit class: "btn btn-primary w-100" %>
<% end %>

